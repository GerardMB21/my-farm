APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true
APP_LOG_LEVEL=info

# AWS / floci (local Cognito+SES emulator on localhost:4566)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Cognito
COGNITO_USER_POOL_ID=REPLACE_ME
COGNITO_CLIENT_ID=REPLACE_ME
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=my-farm-dev.auth.us-east-1.amazoncognito.com

# Google OAuth (via Cognito Hosted UI identity provider)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile

# SES
SES_SENDER_EMAIL=no-reply@my-farm.example.com
